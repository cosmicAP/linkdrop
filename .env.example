# Copy this file to .env and replace the placeholder credentials.
DATABASE_URL=postgresql://linkdrop:change-me@localhost:5432/linkdrop

# Bind address. Use 0.0.0.0 when running in a container or on a PaaS.
# HOST=0.0.0.0

# Most PaaS platforms inject PORT. Locally the app defaults to 8080.
# PORT=8080
