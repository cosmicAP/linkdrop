# Copy this file to .env and replace every <placeholder>.
# Use the database container's real host, NOT localhost, when the database runs
# in a separate container: localhost points back at the app itself.
DATABASE_URL=postgresql://linkdrop:<password>@<database-host>:5432/linkdrop

# Bind address. Use 0.0.0.0 when running in a container or on a PaaS.
# HOST=0.0.0.0

# Most PaaS platforms inject PORT. Nixpacks exposes 3000 for Node, so a
# deployment that lets Nixpacks choose must use PORT=3000.
# PORT=8080
